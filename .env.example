# ── Required ──────────────────────────────────────────────────────────────────
BRAVE_API_KEY=your_brave_api_key_here

# ── Transport: stdio (default) or http ────────────────────────────────────────
BRAVE_MCP_TRANSPORT=stdio

# ── HTTP transport settings (ignored in stdio mode) ───────────────────────────
BRAVE_MCP_PORT=8080
BRAVE_MCP_HOST=0.0.0.0
BRAVE_MCP_STATELESS=false

# ── Logging: debug | info | warning | error ───────────────────────────────────
BRAVE_MCP_LOG_LEVEL=info

# ── Tool filtering (space-separated; mutually exclusive — pick one or neither) ─
# BRAVE_MCP_ENABLED_TOOLS=brave_web_search brave_news_search brave_summarizer
# BRAVE_MCP_DISABLED_TOOLS=brave_summarizer brave_llm_context
